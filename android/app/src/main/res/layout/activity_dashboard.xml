<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sys_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_blue"
        android:padding="24dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dash_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/dash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dash_status"
            android:textColor="#E0F2FE"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM IS UP TO DATE"
            android:textColor="@color/sys_green"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No updates available at this time."
            android:textColor="@color/sys_text_muted"
            android:textSize="14sp"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/dash_settings_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/sys_card"
            android:textColor="@color/sys_text"
            android:text="@string/dash_settings"
            android:textSize="16sp"
            android:drawableLeft="@android:drawable/ic_menu_preferences"
            android:drawablePadding="8dp"
            android:paddingLeft="24dp"
            android:gravity="center_vertical" />
    </LinearLayout>
</LinearLayout>