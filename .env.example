# ============================================================
# PHANTOM2 — Example environment file
# Copy this file to `.env` and fill in your own values.
# The `.env` file is gitignored and never leaves your machine.
# ============================================================

# C2 server host (IP address or domain)
C2_HOST=

# C2 server port (default 8080)
C2_PORT=8080

# Dropper HTTP port (default 8090)
DROPPER_PORT=8090

# 16-character hex token for the dropper payload endpoint
# Generate with: node -e "console.log(require('crypto').randomBytes(8).toString('hex'))"
DROPPER_TOKEN=

# Kimi / Moonshot AI API key for the AI Analysis tab (optional)
KIMI_API_KEY=

# Android SDK path (Windows example)
ANDROID_SDK_PATH=C:\\android-sdk